PORT=3001
# Host port 5434 maps to the docker-compose postgres container (see docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/helpdesk?schema=public
# Min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-secret
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated browser origins allowed to call the auth API (Vite dev server origin in dev)
TRUSTED_ORIGINS=http://localhost:5173
# Seeded admin account (bun run db:seed)
ADMIN_EMAIL=admin@example.com
# Use a strong, randomly generated password. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=CHANGE-ME-use-a-strong-random-password
# Shared secret the inbound-email webhook requires in the X-Inbound-Secret header.
# Generate with: openssl rand -base64 24
INBOUND_EMAIL_SECRET=replace-me-with-a-random-secret
# Anthropic key used by the "Polish" action on the reply composer, the ticket
# "Summarize" action, and automatic category classification of inbound tickets.
# The first two 503 without it and classification is skipped (tickets arrive
# uncategorised for an agent to set); the rest of the API is fine.
ANTHROPIC_API_KEY=replace-me-with-an-anthropic-api-key
# Optional — model used to polish agent replies (defaults to claude-sonnet-5).
POLISH_MODEL=claude-sonnet-5
# Optional — model used to summarize tickets (defaults to claude-sonnet-5).
SUMMARY_MODEL=claude-sonnet-5
# Optional — model used to classify inbound tickets (defaults to claude-haiku-4-5).
CLASSIFY_MODEL=claude-haiku-4-5

# Auto-resolve: on arrival, a background job asks Claude whether the knowledge
# base (backend/knowledge-base.md) fully answers the ticket. If it does, the
# reply is written and the ticket is resolved; otherwise it lands in front of an
# agent as `open`. Without ANTHROPIC_API_KEY every ticket is escalated instead.
# Set to false to skip the model entirely — tickets then go straight to `open`.
AUTO_RESOLVE_ENABLED=true
# Optional — model used to auto-resolve tickets (defaults to claude-sonnet-5).
AUTO_RESOLVE_MODEL=claude-sonnet-5
# Optional — 0–1. The model reports its own confidence that the knowledge base
# answers the ticket; anything below this is escalated. Defaults to 0.8.
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.8
# Optional — the From identity on an auto-sent reply. No staff member wrote it,
# so it is deliberately not attributed to a user.
SUPPORT_EMAIL=support@example.com
SUPPORT_NAME=Support
# Optional — override the knowledge base location (defaults to
# backend/knowledge-base.md, resolved relative to the source, not the cwd).
# KNOWLEDGE_BASE_PATH=
# Optional — the "AI" agent an inbound ticket is assigned to while the
# auto-resolve worker owns it (it is unassigned again if the model escalates).
# Create it with `bun run db:seed:ai`; the account deliberately has no password
# and cannot sign in. Defaults to ai@helpdesk.local. If the user is missing,
# tickets simply arrive unassigned — nothing breaks.
AI_AGENT_EMAIL=ai@helpdesk.local
