PORT=3001
# Host port 5434 maps to the docker-compose postgres container (see docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/helpdesk?schema=public
# Min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-secret
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated browser origins allowed to call the auth API (Vite dev server origin in dev)
TRUSTED_ORIGINS=http://localhost:5173
# Seeded admin account (bun run db:seed)
ADMIN_EMAIL=admin@example.com
# Use a strong, randomly generated password. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=CHANGE-ME-use-a-strong-random-password
# Shared secret guarding both inbound-email webhook routes. Postmark cannot set a
# request header on its inbound webhook and does not sign the payload, so the
# secret can also ride in the URL. Any of these is accepted:
#   X-Inbound-Secret: <secret>
#   POST /api/webhooks/postmark/inbound?secret=<secret>
#   HTTP basic auth — https://postmark:<secret>@your-host/api/webhooks/postmark/inbound
# Prefer basic auth in production: query strings end up in access logs.
# Use a URL-safe value if you put it in a URL. Generate with: openssl rand -hex 24
INBOUND_EMAIL_SECRET=replace-me-with-a-random-secret
# Optional — body-size limit for the Postmark inbound route (default 10mb). Its
# payload carries the full HTML part plus base64 attachments, so it needs far more
# than the 100kb the rest of the API allows. Raise it if Postmark reports 413s.
# INBOUND_EMAIL_MAX_SIZE=10mb

# Postmark server token (Servers → your server → API Tokens), used to send agent
# and AI replies. Without it nothing is emailed: replies are still stored and the
# thread marks each one as not delivered, so dev works with no token at all.
# Sending runs on the `email-send` queue, so a failure is retried rather than
# lost, and a permanent rejection is recorded on the message.
POSTMARK_SERVER_TOKEN=replace-me-with-a-postmark-server-token
# Optional — the Postmark message stream to send on (defaults to `outbound`,
# which is the default transactional stream on a new server).
# POSTMARK_MESSAGE_STREAM=outbound
# Anthropic key used by the "Polish" action on the reply composer, the ticket
# "Summarize" action, and automatic category classification of inbound tickets.
# The first two 503 without it and classification is skipped (tickets arrive
# uncategorised for an agent to set); the rest of the API is fine.
ANTHROPIC_API_KEY=replace-me-with-an-anthropic-api-key
# Optional — model used to polish agent replies (defaults to claude-sonnet-5).
POLISH_MODEL=claude-sonnet-5
# Optional — model used to summarize tickets (defaults to claude-sonnet-5).
SUMMARY_MODEL=claude-sonnet-5
# Optional — model used to classify inbound tickets (defaults to claude-haiku-4-5).
CLASSIFY_MODEL=claude-haiku-4-5

# Auto-resolve: on arrival, a background job asks Claude whether the knowledge
# base (backend/knowledge-base.md) fully answers the ticket. If it does, the
# reply is written and the ticket is resolved; otherwise it lands in front of an
# agent as `open`. Without ANTHROPIC_API_KEY every ticket is escalated instead.
# Set to false to skip the model entirely — tickets then go straight to `open`.
AUTO_RESOLVE_ENABLED=true
# Optional — model used to auto-resolve tickets (defaults to claude-sonnet-5).
AUTO_RESOLVE_MODEL=claude-sonnet-5
# Optional — 0–1. The model reports its own confidence that the knowledge base
# answers the ticket; anything below this is escalated. Defaults to 0.8.
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.8
# The helpdesk's own email identity: the From on every outbound reply (agent and
# AI alike), the attribution stored on an auto-sent one, and the domain the
# outbound Message-Ids are minted in. It must be covered by a verified Postmark
# sender signature — Postmark refuses to send From anything else — which is why
# it replaces the agent's own address, whose name still travels as the display
# name. POSTMARK_FROM_EMAIL wins if both are set.
POSTMARK_FROM_EMAIL=support@example.com
# SUPPORT_EMAIL=support@example.com
SUPPORT_NAME=Support
# The Postmark INBOUND address, set as Reply-To on every email we send. This is
# what makes a customer's reply come back into the helpdesk instead of landing in
# someone's mailbox: the From above is a verified sender signature, and such an
# address is usually a real mailbox or a forwarding alias that never reaches the
# webhook. It must NOT be the same address as the From.
# Find it under Servers -> your server -> Settings -> Inbound (or `GET /server`,
# field `InboundAddress`). Leaving it unset logs a warning on every send, because
# Postmark then defaults Reply-To to the From address and replies are lost.
POSTMARK_INBOUND_ADDRESS=replace-me@inbound.postmarkapp.com
# Optional — override the knowledge base location (defaults to
# backend/knowledge-base.md, resolved relative to the source, not the cwd).
# KNOWLEDGE_BASE_PATH=
# Optional — the "AI" agent an inbound ticket is assigned to while the
# auto-resolve worker owns it (it is unassigned again if the model escalates).
# Create it with `bun run db:seed:ai`; the account deliberately has no password
# and cannot sign in. Defaults to ai@helpdesk.local. If the user is missing,
# tickets simply arrive unassigned — nothing breaks.
AI_AGENT_EMAIL=ai@helpdesk.local
