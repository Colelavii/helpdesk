# Committed on purpose: this configures the DISPOSABLE local test database used
# by the Playwright e2e suite and contains no real secrets. The test DB is
# tmpfs-backed and wiped on container stop. Never put production values here.
NODE_ENV=test

# Test backend runs on a dedicated port so it can run alongside `bun run dev`.
PORT=3101

# Points at the postgres-test service (docker-compose `test` profile), port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/helpdesk_test?schema=public

# Throwaway secret — test-only, must be >= 32 chars.
BETTER_AUTH_SECRET=e2e-test-secret-not-for-production-0123456789
BETTER_AUTH_URL=http://localhost:3101

# Browser origin of the test frontend (Vite dev server on the test port).
TRUSTED_ORIGINS=http://localhost:5273

# Seeded admin for tests (bun run db:seed).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=e2e-test-admin-password

# Shared secret for the inbound-email webhook (test-only).
INBOUND_EMAIL_SECRET=e2e-test-inbound-secret

# No ANTHROPIC_API_KEY is configured for e2e, so the auto-resolve worker would
# only ever fail the model call and hand tickets to `open` anyway. Disabling it
# outright makes that same "hand to open" transition happen synchronously,
# inside the webhook request, instead of racing an async queue worker — every
# existing spec that seeds a ticket via the webhook and expects it to be
# immediately "open" (e.g. ticket-detail.spec.ts, tickets.spec.ts) depends on
# this being deterministic. Specs that need to observe a ticket still sitting
# at `new`/`processing` seed the row directly instead (see
# e2e/helpers/seed-ticket.ts) rather than fighting this setting.
AUTO_RESOLVE_ENABLED=false

# Base URL of the test backend — used by the Playwright runner process to
# construct direct API URLs (e.g. for webhook specs that bypass the browser).
API_BASE_URL=http://localhost:3101
