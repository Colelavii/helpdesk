// Prisma schema for the helpdesk app.
// Run `bun run db:migrate` after changes to create a migration and apply it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  agent
}

// `new` and `processing` are the AI auto-resolve window: a ticket arrives as
// `new`, the auto-resolve worker claims it as `processing`, and it leaves as
// `resolved` (answered from the knowledge base) or `open` (escalated to an
// agent). Both are hidden from the default ticket list so an agent never picks
// up a ticket the model is mid-way through answering.
enum TicketStatus {
  new
  processing
  open
  resolved
  closed
}

enum TicketCategory {
  general
  technical
  refund
}

enum MessageDirection {
  inbound
  outbound
}

// Better Auth models. Password lives on Account.password, not User.
model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  role            Role      @default(agent)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Soft delete: non-null means the user is deactivated (hidden from lists,
  // sessions revoked, sign-in blocked). Unknown to Better Auth — managed by us.
  deletedAt       DateTime?
  sessions        Session[]
  accounts        Account[]
  assignedTickets Ticket[]
  sentMessages    Message[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A support request. Created from an inbound email (see the inbound-email
// webhook) or, later, manually. The requester is the student emailing in — not
// a User (Users are staff). Category is left unset at intake; AI will set it.
model Ticket {
  id             Int             @id @default(autoincrement())
  subject        String
  requesterEmail String
  requesterName  String
  status         TicketStatus    @default(new)
  category       TicketCategory?
  assignedToId   String?
  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  messages       Message[]
  // Set only when the auto-resolve worker answered the ticket itself. Kept as
  // audit data after a student reply reopens the ticket, so the list query keys
  // its "hide AI-resolved" rule on the status as well (see routes/tickets.ts).
  aiResolvedAt   DateTime?
  // The model's own 0–1 confidence and its stated reason, recorded on both
  // outcomes so an escalation can be explained without re-running the model.
  aiConfidence   Float?
  aiDecision     String?
  // Set when the ticket *reaches* `resolved`, by the auto-resolve worker or an
  // agent, and cleared when a student's reply reopens it. Survives
  // `resolved -> closed`. `updatedAt` can't stand in for it: any later edit
  // bumps that, so the resolution time would drift every time the ticket is
  // touched. Time-to-resolve on the dashboard is `resolvedAt - createdAt`.
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@map("ticket")
}

// One email in a ticket thread. `messageId` is the email's Message-Id; it's
// unique so retries don't duplicate, and `inReplyTo`/`references` thread replies
// onto an existing ticket. `sentBy` is the agent for outbound messages, null for
// inbound (student) ones.
model Message {
  id            Int              @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction     MessageDirection
  fromEmail     String
  fromName      String
  // `body` is the canonical plain-text form and is always present — it's what
  // the thread renders and what AI reads. `bodyHtml` is the optional rich
  // version (an email's text/html part); null when the source had none.
  body          String
  bodyHtml      String?
  messageId     String?          @unique
  inReplyTo     String?
  references    String[]
  sentById      String?
  sentBy        User?            @relation(fields: [sentById], references: [id])
  // Delivery state of an *outbound* message, written by the email-send worker.
  // Both stay null on an inbound message: nothing is delivered for mail we
  // received. On an outbound one, `sentAt` non-null means Postmark accepted it;
  // `deliveryError` holds the last failure and is cleared by a later success.
  // Neither set means it hasn't left — queued, sending disabled, or (for rows
  // predating outbound send) never attempted at all.
  sentAt        DateTime?
  deliveryError String?
  createdAt     DateTime         @default(now())

  @@index([ticketId])
  @@map("message")
}
